generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model GuildConfig {
  id                              String                @id @default(cuid()) @db.VarChar(191)
  guildId                         String                @unique @db.VarChar(32)
  ticketCategoryId                String?               @db.VarChar(32)
  enabled                         Boolean               @default(true)
  maxLearnedItems                 Int                   @default(50)
  escalationCategoryId            String?               @db.VarChar(32)
  escalationNotificationChannelId String?               @db.VarChar(32)
  maxAdminRoutes                  Int                   @default(10)
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt
  learnedAnswers                  LearnedAnswer[]
  ticketChannels                  TicketChannel[]
  adminRoutes                     AdminRoute[]
  ignoredChannels                 GuildIgnoredChannel[]
  aiEnabled                       Boolean               @default(true)
  aiProvider                      String                @default("groq") @db.VarChar(32)
  aiModel                         String?               @db.VarChar(191)
  aiSystemPrompt                  String?               @db.Text
}

model LearnedAnswer {
  id        String      @id @default(cuid()) @db.VarChar(191)
  guildId   String      @db.VarChar(32)
  type      String      @default("qna") @db.VarChar(32)
  question  String?     @db.Text
  answer    String?     @db.Text
  title     String?     @db.VarChar(191)
  content   String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  guild     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@index([guildId, type])
}

model AdminRoute {
  id          String      @id @default(cuid()) @db.VarChar(191)
  guildId     String      @db.VarChar(32)
  roleId      String      @db.VarChar(32)
  description String      @db.VarChar(700)
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  guild       GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, roleId])
  @@index([guildId])
  @@index([guildId, enabled])
}

model TicketChannel {
  id                              String      @id @default(cuid()) @db.VarChar(191)
  guildId                         String      @db.VarChar(32)
  channelId                       String      @unique @db.VarChar(32)
  userId                          String?     @db.VarChar(32)
  closed                          Boolean     @default(false)
  status                          String      @default("open") @db.VarChar(32)
  createdAt                       DateTime    @default(now())
  updatedAt                       DateTime    @updatedAt
  aiEnabled                       Boolean     @default(true)
  lastAiReplyAt                   DateTime?
  lastUserMessageAt               DateTime?
  closedByAi                      Boolean     @default(false)
  closedAt                        DateTime?
  renamedByAiAt                   DateTime?
  lastAiAction                    String?     @db.VarChar(64)
  lastAiActionAt                  DateTime?
  escalated                       Boolean     @default(false)
  escalatedAt                     DateTime?
  escalatedRoleId                 String?     @db.VarChar(32)
  escalationReason                String?     @db.VarChar(500)
  escalationNotificationMessageId String?     @db.VarChar(32)
  guild                           GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@index([guildId, status])
  @@index([guildId, escalated])
}

model GuildIgnoredChannel {
  id        String      @id @default(cuid()) @db.VarChar(191)
  guildId   String      @db.VarChar(32)
  channelId String      @db.VarChar(32)
  reason    String?     @db.VarChar(300)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  guild     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, channelId])
  @@index([guildId])
}

model AiUsageLog {
  id               String   @id @default(cuid()) @db.VarChar(191)
  guildId          String   @db.VarChar(32)
  channelId        String   @db.VarChar(32)
  userId           String?  @db.VarChar(32)
  provider         String   @db.VarChar(32)
  model            String?  @db.VarChar(191)
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  status           String   @db.VarChar(96)
  error            String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([guildId, createdAt])
}

model GuildSetting {
  id                   String             @id @default(cuid()) @db.VarChar(191)
  guildId              String             @unique @db.VarChar(32)
  aiReplyEnabled       Boolean            @default(true)
  closeTicketEnabled   Boolean            @default(true)
  renameReviewEnabled  Boolean            @default(true)
  escalationEnabled    Boolean            @default(true)
  agentActionsEnabled  Boolean            @default(true)
  groqApiKeyEncrypted  String?            @db.Text
  aiModel              String?            @db.VarChar(191)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  guildBlockedTerms    GuildBlockedTerm[]
  guildAllowedTerms    GuildAllowedTerm[]
}

model BlockedTerm {
  id             String   @id @default(cuid()) @db.VarChar(191)
  term           String   @db.VarChar(191)
  normalizedTerm String   @unique @db.VarChar(191)
  locale         String   @default("en") @db.VarChar(16)
  category       String   @db.VarChar(32)
  severity       String   @default("medium") @db.VarChar(16)
  matchType      String   @default("token") @db.VarChar(16)
  enabled        Boolean  @default(true)
  source         String   @default("pixy") @db.VarChar(32)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled])
  @@index([category])
  @@index([severity])
  @@index([matchType])
  @@index([enabled, category])
}

model GuildBlockedTerm {
  id             String       @id @default(cuid()) @db.VarChar(191)
  guildId        String       @db.VarChar(32)
  term           String       @db.VarChar(191)
  normalizedTerm String       @db.VarChar(191)
  category       String       @default("custom") @db.VarChar(32)
  severity       String       @default("medium") @db.VarChar(16)
  matchType      String       @default("token") @db.VarChar(16)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  setting        GuildSetting @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, normalizedTerm])
  @@index([guildId])
  @@index([guildId, enabled])
}

model GuildAllowedTerm {
  id             String       @id @default(cuid()) @db.VarChar(191)
  guildId        String       @db.VarChar(32)
  term           String       @db.VarChar(191)
  normalizedTerm String       @db.VarChar(191)
  reason         String?      @db.VarChar(300)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  setting        GuildSetting @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, normalizedTerm])
  @@index([guildId])
}

model GuildBilling {
  id             String   @id @default(cuid()) @db.VarChar(191)
  guildId        String   @unique @db.VarChar(32)
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  proStartedAt   DateTime?
  proEndsAt      DateTime?
  partnerActive  Boolean  @default(false)
  partnerSince   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([partnerActive, partnerSince])
  @@index([trialEndsAt])
  @@index([proEndsAt])
}

model BillingEvent {
  id                String   @id @default(cuid()) @db.VarChar(191)
  guildId           String   @db.VarChar(32)
  actorUserId       String   @db.VarChar(32)
  action            String   @db.VarChar(64)
  durationValue     Int?
  durationUnit      String?  @db.VarChar(16)
  previousProEndsAt DateTime?
  newProEndsAt      DateTime?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}
