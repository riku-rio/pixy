generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model GuildConfig {
  id               String   @id @default(cuid())
  guildId          String   @unique
  ticketCategoryId String?
  enabled          Boolean  @default(true)
  maxLearnedItems  Int      @default(20)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  learnedAnswers   LearnedAnswer[]
  ticketChannels   TicketChannel[]

  aiEnabled Boolean @default(true)
  aiProvider String @default("groq")
  aiModel String?
  aiSystemPrompt String?
}

model LearnedAnswer {
  id        String   @id @default(cuid())
  guildId   String

  type      String   @default("qna") // qna | freeform

  question  String?
  answer    String?

  title     String?
  content   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@index([guildId, type])
}

model TicketChannel {
  id        String   @id @default(cuid())
  guildId   String
  channelId String   @unique
  userId    String?

  closed    Boolean  @default(false)
  status    String   @default("open") // open | closed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aiEnabled Boolean @default(true)
  lastAiReplyAt DateTime?
  lastUserMessageAt DateTime?

  closedByAi Boolean @default(false)
  closedAt DateTime?

  renamedByAiAt DateTime?
  lastAiAction String?
  lastAiActionAt DateTime?

  guild     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@index([guildId, status])
}

model AiUsageLog {
  id String @id @default(cuid())

  guildId String
  channelId String
  userId String?

  provider String
  model String?

  promptTokens Int?
  completionTokens Int?
  totalTokens Int?

  status String
  error String?

  createdAt DateTime @default(now())
}
