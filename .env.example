# Bot

# NODE_ENV=production
NODE_ENV=development
DISCORD_TOKEN=
DISCORD_CLIENT_SECRET=
DISCORD_CLIENT_ID=
PREFIX=^

# Database

DATABASE_URL="file:./dev.db"

# Groq (Global fallback - per-server override via /pixy-settings)

GROQ_API_KEY=your_groq_api_key_here
